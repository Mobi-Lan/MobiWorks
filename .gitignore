# ── 빌드 산출물 ──
build/
dist/
*.spec

# ── 릴리스 산출물 (release.py 가 만든다) ──
release/
*.exe
*.exe.bak
SHA256SUMS.txt

# ── Python ──
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# ── Node (tests/js 는 의존성 없이 node 로 바로 돈다 — 혹시 설치했을 때만) ──
node_modules/
npm-debug.log*

# ── 로그 · 임시 ──
*.log
*.tmp
*.bak
*.orig
*.swp

# ── 편집기 · OS ──
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ── 작업용 워크트리 폴더 ──
.claude/worktrees/

# ── 사용자 자료 ──
# 사용자 자료는 %LOCALAPPDATA%\MobiWorks 에 있어 여기 들어올 일이 없다.
# 다만 MOBIW_DATA_DIR 을 저장소 안으로 돌려 두고 개발하면 그대로 커밋될 수 있다 —
# **인증키·기기 토큰·날개 장부**가 들어 있는 파일들이다. 싸게 막아 둔다.
# (저장소 이력 전체를 훑어 지금까지 들어간 적이 없는 것은 확인했다. 앞으로를 막는 것이다.)
data/settings.json
data/devices.json
data/lite.json
data/queue.json
data/recipe_limits.json
data/presets.json
data/cache_*.json
data/*.jsonl
data/*.corrupt-*

# 소개 페이지 원본 — 따로 관리한다
/promo/
